# ==========================================
# SecureWatch IoT — Monorepo Environment Variables
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/securewatch_iot

# Security & Authentication (HS256)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_hs256
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Client Origin (CORS Whitelist)
CLIENT_URL=http://localhost:5173

# MQTT Broker Configuration (Aedes)
MQTT_PORT=1883
MQTT_HOST=0.0.0.0

# Simulator Configuration
SIMULATOR_API_URL=http://localhost:5000/api/v1
SIMULATOR_MQTT_URL=mqtt://localhost:1883
